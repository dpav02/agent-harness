{
  "$schema": "https://opencode.ai/config.json",
  // GA 0731 era (2026-07-31): DeepSeek V4 Flash official weights, served as
  // dsv4-flash on spark1:8888 (+ :8000 alias). Reasoning effort = sibling
  // model ids via the fleet proxy (NOT Ctrl+t variants — openai-compatible
  // does not reliably forward chat_template_kwargs via variants):
  //   fleet/dsv4-flash-high (default) · -low · -max · bare = no thinking.
  "model": "fleet/dsv4-flash-high",
  "small_model": "dgx/dsv4-flash",
  // 2026-07-06 (davebench forensics): the three instruction files were proven
  // behaviorally inert for qwen3.6-27b at ~2K tokens/step of context cost —
  // slimmed to empty for the local-model daily driver. Restore the list when
  // adding a frontier-model provider (instruction-following models use them).
  // Was: ["workflow-agents.md", "testing-agents.md", "planning-spec-driven.md"]
  "instructions": [],
  "compaction": {
    "auto": true,
    // prune rewrites request history -> breaks vLLM prefix caching -> full
    // re-prefill of a huge context at ~10 tok/s. Keep append-only.
    "prune": false,
    "reserved": 20000
  },
  // Goal system: standardized on /loop-goal (plugins/opencode-loop.ts, auto-loaded
  // from the plugins dir — do not also list @bybrawe/opencode-loop here). opencode-goal
  // (/goal) removed 2026-07-19: its auto-continue-until-complete prompt fights the
  // supervised fail-stop loop these locals need (small-model-prompting.md). Do not
  // re-add. The auto-update plugin lives in the machine-managed opencode.json.
  "plugin": [],
  "provider": {
    "dgx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DGX Spark (stable :8000 alias -> live backend)",
      "options": {
        "baseURL": "http://edgexpert-84c0:8000/v1",
        "apiKey": "local",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "dsv4-flash": {
          "name": "DSV4 Flash GA 0731 direct (1M ctx, no thinking — escape hatch when VPS proxy is down)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          // limit.output is schema-required by opencode >=1.18.x. 32000 ==
          // opencode's own internal cap (min(limit.output, 32000)), so this
          // is a no-op, not a regression to the prompt-room-stealing bug.
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        }
      }
    },
    "fleet": {
      "npm": "@ai-sdk/openai-compatible",
      // sparkfleet model proxy on the Hermes VPS: /v1/models = whatever the
      // deployment catalog is serving RIGHT NOW; routes by model id and
      // merges chat_template_kwargs for the effort aliases server-side. A
      // model whose deployment is stopped 404s here with the live list —
      // start it from the sparkfleet dash (:8090 Deploys) first.
      "name": "Spark Fleet (live models via proxy)",
      "options": {
        "baseURL": "http://100.124.23.17:8100/v1",
        "apiKey": "local",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "dsv4-flash-high": {
          "name": "DSV4 Flash GA · high reasoning (fleet default)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          // 393216 (not 32000): the opencode-internal 32K step clamp is
          // binary-patched out (1e300), so limit.output is now the REAL
          // per-step ceiling. 384K = DeepSeek's recommended max-effort output
          // budget; the anemll build is a strict renderer (400s when
          // prompt + max_tokens > 1M ctx), so leave prompt room — do not
          // set this to 1048576.
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        },
        "dsv4-flash-low": {
          "name": "DSV4 Flash GA · low reasoning (brief thinking)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        },
        "dsv4-flash-max": {
          "name": "DSV4 Flash GA · max reasoning (exhaustive, slow)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        },
        "dsv4-flash": {
          "name": "DSV4 Flash GA · fast (no thinking) via proxy",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        },
        "glm-5.2": {
          "name": "GLM-5.2 NVFP4+AQLM TP3 (3x Spark ring, 348k ctx, vision — start its lane from the dash first)",
          // custom openai-compatible providers aren't in opencode's model
          // catalog, so it can't auto-detect capabilities and defaults to
          // text-only, replacing image parts with an "ERROR: Cannot read..."
          // text note even though vLLM/GLM-5.2 accepts them. The real gate
          // (verified in the 1.18.9 bundle) is capabilities.input.image,
          // driven by modalities.input — attachment alone is NOT enough.
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 348160,
            "output": 32000
          },
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        },
        "ornith-35b": {
          "name": "Ornith 1.0 35B APEX (spark4 pair, 262k ctx, vision)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32000
          }
        },
        "ornith-heretic-35b": {
          "name": "Ornith 1.0 35B Heretic APEX (spark4 pair, 131k ctx, vision)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 32000
          }
        }
      }
    }
  }
}
